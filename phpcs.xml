<?xml version="1.0"?>
<ruleset>
	<file>src</file>
	<!--file>tests</file-->
	<file>.phan</file>
	<file>scoper.inc.php</file>

	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg value="s"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.3-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_supported_wp_version" value="7.0"/>
	<rule ref="WordPress">
		<!-- The plugin uses PSR-style naming (camelCase methods/variables, PascalCase class files). -->
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
		<exclude name="WordPress.Files.FileName"/>
		<!-- Code is documented through types; docblocks are not required everywhere. -->
		<exclude name="Squiz.Commenting"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="FioTransactions"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="skaut-fio-bank-transactions"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>
</ruleset>
